{
  "name": "artist",
  "version": "0",
  "dependencies": [
    {
      "name": "skia",
      "default-features": false,
      "features": ["gl", "metal", "harfbuzz", "icu", "jpeg", "png", "webp"],
      "platform": "osx"
    },
    {
      "name": "skia",
      "default-features": false,
      "features": [
        "gl", "harfbuzz", "icu", "jpeg", "png", "webp",
        { "name": "fontconfig", "platform": "linux" },
        { "name": "freetype", "platform": "linux" }
      ],
      "platform": "!osx"
    },
    {
      "name": "cairo",
      "features": ["freetype", "fontconfig"],
      "platform": "windows"
    },
    {
      "name": "harfbuzz",
      "platform": "windows"
    },
    {
      "name": "libwebp",
      "platform": "windows"
    },
    {
      "name": "pkgconf",
      "host": true,
      "platform": "windows"
    }
  ]
}
